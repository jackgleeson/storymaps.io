{
    servers {
        # Cloudflare sits in front of Caddy. Trust its address ranges and take the address of the
        # visitor from CF-Connecting-IP, so logs and the rate limits in the app see real visitors.
        # Only requests from these ranges can set it, so it can't be spoofed by going around
        # Cloudflare. Ranges from https://www.cloudflare.com/ips (checked 2026-10-25).
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

storymaps.io {
    header {
        # HTTPS only, including subdomains, for one year.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Stop browsers from sniffing MIME types away from the declared one.
        X-Content-Type-Options "nosniff"
        # Disallow framing to mitigate clickjacking.
        X-Frame-Options "DENY"
        # Send origin only on cross-origin navigations.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Drop powerful APIs we do not use.
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Don't advertise the server software.
        -Server
    }

    # Access logs, rotated at 10 MB and kept for up to 30 days. The lock password hash sent
    # by the CLI is left out, since credentials are never logged.
    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format filter {
            request>headers>X-Lock-Password delete
        }
    }

    # Pass the app only the address of the visitor, for the per-visitor rate limits
    reverse_proxy app:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}

www.storymaps.io {
    redir https://storymaps.io{uri} permanent
}