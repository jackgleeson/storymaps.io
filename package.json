{
  "name": "userstorymaps",
  "version": "2.0.0",
  "description": "User Story Mapping Tool",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import ./test/setup.js --test --test-concurrency=1 'test/unit/**/*.test.js'",
    "test:integration": "node --import ./test/setup.js --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:coverage": "node --import ./test/setup.js --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='public/vendor/**' 'test/**/*.test.js'"
  },
  "keywords": [
    "user-story",
    "mapping",
    "agile"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "imports": {
    "#js-yaml": "./public/vendor/js-yaml.bundle.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "html2canvas": "^1.4.1",
    "ws": "^8.18.0",
    "y-leveldb": "^0.1.2",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.25.0",
    "firebase-admin": "^13.0.0",
    "y-codemirror.next": "^0.3.5"
  }
}
